DATABASE_URL="postgresql://postgres:password@localhost:5432/sellora?schema=public"
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
AUTH_SECRET="replace-this-with-a-long-random-secret"
# Sellora-managed server key for encrypting every tenant's payment credentials.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set in the API host environment, never in a customer account or frontend.
# PAYMENT_ENCRYPTION_KEY=replace-with-64-hex-characters
