DATABASE_URL="postgresql://postgres:password@localhost:5432/sellora?schema=public"
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
AUTH_SECRET="replace-this-with-a-long-random-secret"
# Sellora-managed server key for encrypting every tenant's payment credentials.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set in the API host environment, never in a customer account or frontend.
# PAYMENT_ENCRYPTION_KEY=replace-with-64-hex-characters

# PixelForge platform-owner bootstrap (required before first db:seed).
# Use your own email address and a unique password of at least 12 characters.
# The seed never logs or stores this password in source control.
PLATFORM_OWNER_EMAIL=you@your-company.com
PLATFORM_OWNER_PASSWORD=replace-with-a-unique-password-at-least-12-chars

# Public API origin used to display the owner-only Razorpay webhook URL.
# Example: https://api.sellora.example
PUBLIC_API_URL=https://your-public-api-domain.example
