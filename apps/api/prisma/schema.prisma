generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTATION_SENT
  CONVERTED
  LOST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  businesses   Business[]
  passwordResetTokens PasswordResetToken[]
}

model YarnCount {
  id        String    @id @default(cuid())
  label     String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model YarnType {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id             String        @id @default(cuid())
  sku            String        @unique
  name           String
  description    String?
  countId        String
  count          YarnCount     @relation(fields: [countId], references: [id])
  yarnTypeId     String
  yarnType       YarnType      @relation(fields: [yarnTypeId], references: [id])
  shades         ProductShade[]
  prices         Price[]
  availability   String        @default("CONTACT")
  isPublished    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([name])
  @@index([isPublished])
}

model Shade {
  id        String         @id @default(cuid())
  name      String
  code      String
  hexColor  String?
  products  ProductShade[]
  createdAt DateTime       @default(now())
  @@unique([name, code])
}

model ProductShade {
  id        String   @id @default(cuid())
  productId String
  shadeId   String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shade     Shade    @relation(fields: [shadeId], references: [id], onDelete: Cascade)
  @@unique([productId, shadeId])
}

model Price {
  id          String        @id @default(cuid())
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("INR")
  unit        String        @default("kg")
  isPublished Boolean       @default(true)
  effectiveAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  history     PriceHistory[]
  @@index([productId, effectiveAt])
}

model PriceHistory {
  id          String   @id @default(cuid())
  priceId     String
  price       Price    @relation(fields: [priceId], references: [id], onDelete: Cascade)
  oldAmount   Decimal? @db.Decimal(12, 2)
  newAmount   Decimal  @db.Decimal(12, 2)
  changedBy   String?
  createdAt   DateTime @default(now())
}

model Catalogue {
  id           String   @id @default(cuid())
  title        String
  originalName String
  filePath     String
  mimeType     String
  fileSize     Int
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Enquiry {
  id           String         @id @default(cuid())
  reference    String         @unique
  customerName String
  businessName String?
  phone        String
  city         String?
  state        String?
  message      String?
  status       EnquiryStatus  @default(NEW)
  items        EnquiryItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@index([status, createdAt])
}

model EnquiryItem {
  id          String   @id @default(cuid())
  enquiryId   String
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  shadeName   String?
  quantity    Decimal  @db.Decimal(12, 3)
  unit        String   @default("kg")
}


// Business onboarding foundation for Sellora's industry-aware catalogue builder.
model Business {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  industry        String
  productCategory String
  businessModel   String
  email           String?
  phone           String?
  address         String?
  website         String?
  logoUrl         String?
  brandColor      String           @default("#599c56")
  sellingMode     String           @default("CATALOG_ONLY")
  taxEnabled      Boolean          @default(false)
  taxRate         Decimal          @default(0) @db.Decimal(5, 2)
  paymentGatewayProvider String?
  paymentGatewayStatus   String    @default("NOT_CONNECTED")

  razorpayKeyId String?
  razorpayKeySecretEncrypted String?
  razorpayWebhookSecretEncrypted String?
  razorpayTestMode Boolean @default(true)
  paymentOrders PaymentOrder[]

  lastOrderNumber Int @default(0)

  catalogueFields CatalogueField[]
  ownerUserId     String?
  owner            User?            @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  products         SelloraProduct[]
  catalogues       SelloraCatalogue[]
  orders           SelloraOrder[]
  customers        SelloraCustomer[]
  enquiries        SelloraEnquiry[]
  stockMovements   SelloraStockMovement[]
  webhookEvents    PaymentWebhookEvent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  @@index([ownerUserId])
}

model CatalogueField {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key        String
  label      String
  type       String
  required   Boolean  @default(false)
  options    Json?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  @@unique([businessId, key])
  @@index([businessId, sortOrder])
}


// Generic Sellora product records. Existing yarn-specific records remain unchanged.
model SelloraProduct {
  id          String             @id @default(cuid())
  businessId  String
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  description String?
  price       Decimal?           @db.Decimal(12, 2)
  currency    String             @default("INR")
  unit        String             @default("piece")
  imageUrl    String?
  stockEnabled Boolean @default(false)
  stockQuantity Decimal? @db.Decimal(12, 3)
  fields      Json               @default("{}")
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  catalogueItems CatalogueProduct[]
  enquiries SelloraEnquiry[]
  stockMovements SelloraStockMovement[]
  @@index([businessId, createdAt])
  @@index([businessId, name])
}

model SelloraCatalogue {
  id          String             @id @default(cuid())
  businessId  String
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  slug        String             @unique
  description String?
  shareImageUrl String?
  isPublished Boolean            @default(false)
  publishedAt DateTime?
  items       CatalogueProduct[]
  orders      SelloraOrder[]
  analyticsEvents CatalogueAnalyticsEvent[]
  enquiries SelloraEnquiry[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  @@index([businessId, createdAt])
}

model CatalogueProduct {
  id          String           @id @default(cuid())
  catalogueId String
  productId   String
  catalogue   SelloraCatalogue @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  product     SelloraProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder   Int              @default(0)
  @@unique([catalogueId, productId])
  @@index([catalogueId, sortOrder])
}

model PaymentOrder {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  catalogueId String
  productId String
  productName String
  quantity Int
  unit String
  amount Decimal @db.Decimal(12, 2)
  currency String @default("INR")
  customerName String
  customerEmail String?
  customerPhone String
  razorpayOrderId String @unique
  razorpayPaymentId String?
  status String @default("CREATED")
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([businessId, createdAt])
  @@index([status, createdAt])
}


model SelloraOrder {
  id           String   @id @default(cuid())
  orderNumber  String   @unique
  razorpayOrderId String? @unique
  razorpayPaymentId String? @unique
  businessId   String
  catalogueId  String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  catalogue    SelloraCatalogue @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  customerName String
  email        String?
  phone        String
  address      String?
  notes        String?
  currency     String
  subtotal     Decimal  @db.Decimal(12, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal  @default(0) @db.Decimal(12, 2)
  status       String   @default("PENDING")
  paymentStatus String @default("UNPAID")
  paidAt       DateTime?
  customerId   String?
  customer     SelloraCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  refundStatus String @default("NONE")
  razorpayRefundId String?
  items        SelloraOrderItem[]
  stockMovements SelloraStockMovement[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([businessId, createdAt])
  @@index([catalogueId, createdAt])
  @@index([customerId, createdAt])
}

model SelloraOrderItem {
  id          String       @id @default(cuid())
  orderId     String
  order       SelloraOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  sku         String?
  unit        String
  quantity    Int
  unitPrice   Decimal      @db.Decimal(12, 2)
  lineTotal   Decimal      @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())
  @@index([orderId])
}

model SelloraCustomer {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  name String
  email String?
  phone String?
  address String?
  city String?
  notes String?
  orders SelloraOrder[]
  enquiries SelloraEnquiry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, name])
}

model SelloraEnquiry {
  id String @id @default(cuid())
  reference String @unique
  businessId String
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  catalogueId String?
  catalogue SelloraCatalogue? @relation(fields:[catalogueId], references:[id], onDelete:SetNull)
  productId String?
  product SelloraProduct? @relation(fields:[productId], references:[id], onDelete:SetNull)
  customerId String?
  customer SelloraCustomer? @relation(fields:[customerId], references:[id], onDelete:SetNull)
  customerName String
  email String?
  phone String?
  companyName String?
  message String?
  status String @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([businessId, status, createdAt])
  @@index([businessId, phone])
}

model SelloraStockMovement {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  productId String
  product SelloraProduct @relation(fields:[productId], references:[id], onDelete:Cascade)
  orderId String?
  order SelloraOrder? @relation(fields:[orderId], references:[id], onDelete:SetNull)
  quantityDelta Decimal @db.Decimal(12, 3)
  reason String
  note String?
  createdAt DateTime @default(now())
  @@index([businessId, createdAt])
  @@index([productId, createdAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model PaymentWebhookEvent {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields:[businessId], references:[id], onDelete:Cascade)
  eventId String
  eventType String
  processedAt DateTime @default(now())
  @@unique([businessId, eventId])
  @@index([businessId, eventType, processedAt])
}

model CatalogueAnalyticsEvent {
  id          String   @id @default(cuid())
  catalogueId String
  catalogue   SelloraCatalogue @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  eventType   String
  sessionId   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  @@index([catalogueId, eventType, createdAt])
  @@index([catalogueId, sessionId, eventType])
}